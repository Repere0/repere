# Donnees sources : plusieurs Go, retelechargeables depuis data.gouv.fr.
# Un depot garde ce qui ne se retrouve pas ailleurs, pas ce qui se retelecharge.
*.csv
ofgl-*
elus-*

# Sorties engendrees : build_pwa.py les refabrique a l'identique.
site_v*/
site_a_deployer/
site_engendre/
repere_site*.zip
repere_pwa*.zip

# Journal de pousser.bat. POURQUOI IL NE DOIT PAS ETRE SUIVI : le script y ecrit
# pendant que git rebase le depot. Git tente alors de remplacer un fichier que
# le script tient ouvert, echoue avec « unable to unlink old », et laisse un
# autostash a moitie pose qui bloque toutes les tentatives suivantes. Un journal
# d'execution n'a de toute facon rien a faire dans l'historique du code.
journal_pousser.txt

# Obsidian : la configuration du coffre est versionnee (elle fait partie du poste de
# travail), mais l'etat des fenetres change a chaque ouverture et n'a rien a y faire.
data/.obsidian/workspace.json
data/.obsidian/workspace-mobile.json
data/.trash/

# Bruit de systeme
desktop.ini
Thumbs.db
node_modules/
data/*.zip
data/brut_*/
