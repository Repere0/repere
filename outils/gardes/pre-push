#!/bin/sh
# GARDE 2 — AUCUN PUSH VERS main DEPUIS CE DEPOT.
#
# La garde pre-commit arrete un commit local. Celle-ci arrete l'envoi : un
# `git push origin <branche>:main` ne passe par aucun commit et lui echapperait.
# Elle lit la liste des references poussees sur son entree standard, comme git la
# fournit, et refuse des que la reference distante est main.

REFUS=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  case "$REMOTE_REF" in
    refs/heads/main) REFUS=1 ;;
  esac
done

if [ "$REFUS" = "1" ] && [ "$REPERE_FUSION" != "1" ]; then
  echo ""
  echo "  REFUS : ce depot ne pousse pas vers main."
  echo ""
  echo "  Pousse ta branche de travail, et fusionne ensuite, en le sachant :"
  echo "      git push origin audit-finalisation-repere"
  echo "      REPERE_FUSION=1 git push origin main"
  echo ""
  exit 1
fi
exit 0
