# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Deux espaces en fin de ligne sont un saut de ligne en Markdown.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.html]
# app_repere_v18_20.html est une source de données : ne jamais le reformater.
insert_final_newline = unset
trim_trailing_whitespace = unset
