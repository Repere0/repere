{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepereAgentTaskPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "objective",
    "risk",
    "allowed_paths",
    "acceptance_criteria",
    "estimated_cost_usd",
    "max_turns",
    "rationale"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "objective": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "risk": {
      "type": "string",
      "enum": [
        "green",
        "orange",
        "red"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      }
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "rationale": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1500
    }
  }
}
