{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepereAgentTaskPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "objective",
    "risk",
    "allowed_paths",
    "acceptance_criteria",
    "estimated_cost_usd",
    "max_turns",
    "rationale"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "green",
        "orange",
        "red"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_cost_usd": {
      "type": "number"
    },
    "max_turns": {
      "type": "integer"
    },
    "rationale": {
      "type": "string"
    }
  }
}
