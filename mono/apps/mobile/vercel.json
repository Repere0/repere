{
  "framework": null,
  "installCommand": "cd ../.. && npx pnpm@8.15.9 install --frozen-lockfile && npx pnpm@8.15.9 extract",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!data/|_expo/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] }
  ]
}
