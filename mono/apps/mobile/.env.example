# Modèle de configuration de l'application mobile. Copier en `.env` (jamais commité).
# ATTENTION : toute variable EXPO_PUBLIC_* est intégrée à l'application et lisible
# par n'importe quel utilisateur. N'y mettre AUCUN secret (clé, mot de passe, jeton).

# Adresse de contact affichée dans « À propos » (src/app/a-propos.tsx).
# Vide : aucun bouton de contact n'est affiché.
EXPO_PUBLIC_CONTACT_EMAIL=

# Adresse des données publiées (src/lib/donnees.ts). Vide : la production
# (https://repereapp.netlify.app/data). Pour une copie locale : /data
EXPO_PUBLIC_REPERE_DONNEES=

# Emojis de catégorie (src/ui/resume.tsx). Décision du 30/09/2026 : désactivés.
# 1 pour les activer lors d'un test comparatif, sinon laisser vide.
EXPO_PUBLIC_REPERE_EMOJIS=
